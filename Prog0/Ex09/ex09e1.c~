#include <stdio.h>
#define NUM 3

int main()
{
  int map[NUM][NUM];
  int i, j, m, n;
  int flag = 0, subflag = 0;

  for (i=0 ; i<NUM ; i++)
    for (j=0 ; j<NUM ; j++)
      map[i][j] = 0;

  while(1){

    for (i=0 ; i<NUM ; i++){
      for (j=0 ; j<NUM ; j++){
	if (map[i][j]==1) printf("(%d %d) ⚪︎", i, j);
	else if (map[i][j]==-1) printf("(%d %d) × ", i, j);
	else printf("(%d %d)     ", i, j);
      }
      printf("\n");
    }

    if (flag==0) {
      printf("⚪の番です\n座標を行・列の順で入力してください：");
      scanf("%d%d", &m, &n);
      if (m >= 0 && m <= 2 && n >= 0 && n <= 2 && map[m][n] != -1){
      map[m][n] = 1;
      flag = 1;
      subflag == 0;
      }else subflag = 1;

      while (subflag == 1){
	printf("入力に誤りがあります。もう一度入力してください：");
	
	scanf("%d%d", &m, &n);
        if (m >= 0 && m <= 2 && n >= 0 && n <= 2 && map[m][n] != -1){
        map[m][n] = 1;
        flag = 1;
	subflag = 0;
        }
      }
    }else{
      printf("×の番です\n座標を行・列の順で入力してください：");
      scanf("%d%d", &m, &n);
      if (m >= 0 && m <= 2 && n >= 0 && n <= 2 && map[m][n] != 1){
      map[m][n] = -1;
      flag = 0;
      subflag = 0;
      }else subflag = 1;

      while(subflag == 1){
	printf("入力に誤りがあります。もう一度入力してください：");
	
	scanf("%d%d", &m, &n);
        if (m >= 0 && m <= 2 && n >= 0 && n <= 2 && map[m][n] != 1){
        map[m][n] = -1;
        flag = 0;
	subflag = 0;
        }
    }
  }

  return 0;
}
