#include <stdio.h>

int main()
{
  int n, array[15] = {1, 7, 10, 18, 27, 31, 42, 49, 54, 50, 61, 67, 72, 88, 93};

  printf("添字を入力してください：");
  scanf("%d", &n);
  
  if( n >= 0 && n <= 14)
  {
  printf("array[%d] = %d\n", n, array[n]);

  if( array[n] % 3 == 0 ) printf("  3の倍数です\n");
  else printf("  3の倍数ではありません\n");
  }
  else{ printf("範囲外です！\n");}

  return 0;
}
